# ============================================================
# 策略：預設全部忽略，只用白名單把「程式碼 + 文件」放行。
# 資料（raw_data / output / ABS / TEDS / PDF / key / pages）一律不上傳。
# 要新增可上傳的資料夾時，照下面的 pattern 加一組 !dir/ + dir/* 即可。
# ============================================================

# --- 1. 先把最外層全部擋掉 -----------------------------------
/*

# --- 2. 放行最外層的檔案 -------------------------------------
!/.gitignore
!/README.md

# --- 3. 放行最外層的分析程式資料夾（未來要建的 code/）--------
!/code/

# --- 4. 一路挖進 data/NTUWS/Code/ ----------------------------
!/data/
/data/*
!/data/NTUWS/
/data/NTUWS/*
!/data/NTUWS/Code/

# 之後若要一起上傳 NTUWS 的文件，把下面幾行取消註解：
# !/data/NTUWS/README.md
# !/data/NTUWS/PHASE2_README.md
# !/data/NTUWS/QUESTION_INVENTORY.md
# !/data/NTUWS/PHASE2_QUESTION_CATALOG.md

# 之後若要加 ABS 的程式碼，比照辦理：
# !/data/ABS/
# /data/ABS/*
# !/data/ABS/*.R

# --- 5. 無論在哪一層，這些都不要（放最後，優先權最高）--------
# macOS / 編輯器雜物
.DS_Store
._*
.Rhistory
.RData
.Ruserdata
.Rproj.user/
*.Rproj
.vscode/
.idea/
__pycache__/
*.pyc
.ipynb_checkpoints/
.Renviron
.env

# 資料檔：任何層級都擋，避免以後不小心 commit 進去
*.csv
*.tsv
*.xlsx
*.xls
*.sav
*.dta
*.rds
*.RDS
*.rda
*.zip
*.rar
*.7z
*.pdf
*.key
*.pages
*.docx
*.pptx

# 圖檔輸出（如果之後想上傳成果圖，把這段刪掉）
*.png
*.jpg
*.jpeg
*.svg
*.html

# 常見的輸出資料夾名稱
output/
outputs/
raw_data/

# 跨資料集對照：decisions.csv 是人工審核的成果，是整條 pipeline 唯一
# 不可重生的東西，必須進版控。
# 注意 git 的規則：父目錄被忽略時，底下的 ! 例外是無效的，
# 所以要從 output/ 開始逐層開一條路，只放行這一個檔案，其餘照舊忽略。
!output/
output/*
!output/crosswalk/
output/crosswalk/*
!output/crosswalk/candidates/
output/crosswalk/candidates/*
!output/crosswalk/candidates/decisions.csv

# ============================================================
# raking 專案：上傳 data/code、data/Input、data/output 三個資料夾
#
# 這一段必須放在檔案「最後面」——上面的 *.csv / *.png / *.xlsx /
# output/ 等規則優先權較高，只有寫在後面的 ! 例外才蓋得過去。
# 另外 git 的規則是：父目錄被忽略時，底下的 ! 例外無效，
# 所以每一層目錄都要重新放行一次。
# ============================================================

# --- data/code：程式與說明文件 -------------------------------
!/data/code/
/data/code/*
!/data/code/*.R
!/data/code/*.md
!/data/code/Calculate_stat_population_from_TEDS/
/data/code/Calculate_stat_population_from_TEDS/*
!/data/code/Calculate_stat_population_from_TEDS/*.R
!/data/code/Calculate_stat_population_from_TEDS/*.md

# --- data/Input：只放行母體目標檔與說明 ----------------------
# ★ NTUWS_pooled/ 含個人層資料，整個資料夾不上傳（下面沒有放行它）
!/data/Input/
/data/Input/*
!/data/Input/README.md
!/data/Input/population_targets/
/data/Input/population_targets/*
!/data/Input/population_targets/*.csv

# 保險起見再明確擋一次 NTUWS_pooled 的資料檔
/data/Input/NTUWS_pooled/**
/data/Input/NTUWS_pooled/*.csv
/data/Input/NTUWS_pooled/*.xlsx

# --- data/output：表、圖、診斷檔 -----------------------------
!/data/output/
/data/output/*
!/data/output/README.md
!/data/output/portion_of_TEDS/
/data/output/portion_of_TEDS/*
!/data/output/portion_of_TEDS/*/
!/data/output/portion_of_TEDS/*/*.csv
!/data/output/portion_of_TEDS/*/*.md
!/data/output/portion_of_TEDS/*/*.png
!/data/output/raking/
/data/output/raking/*
!/data/output/raking/README.md
!/data/output/raking/*/
!/data/output/raking/*/*.csv
!/data/output/raking/*/*.png
!/data/output/raking/*/*.txt

# --- 修正：上面第 5 段的 `!output/` 會把「任何一層」叫 output 的資料夾
#     都放行（因為它沒有斜線，不受根目錄錨定），連帶讓
#     data/NTUWS/output/ 底下的 .md 檔漏出去。這裡明確擋回來。
/data/NTUWS/output/

# ============================================================
# multilevel calibration + PAPP-BART（2026-09）
#
# 放行：兩個新方法的程式、TEDS 聯合分布表、三種方法的權數與報表。
# 不放行：個人層的 analysis_*.csv、以及每個 run 重複產生的分布圖／合併對比圖
#         （collapse_ 圖與加權方法無關，60 個檔其實只有 6 張不同的圖）。
# 圖只留代表性的：教育的分布圖 + 各方法專有的診斷圖。
# 一樣要逐層放行，而且這一段必須在檔案最後面。
# ============================================================

# --- 文件 ----------------------------------------------------
!/README.en.md
!/data/code/*.en.md
!/data/code/Calculate_stat_population_from_TEDS/*.en.md

# --- 母體：TEDS 聯合分布表 -----------------------------------
!/data/output/portion_of_TEDS/*/joint/
/data/output/portion_of_TEDS/*/joint/*
!/data/output/portion_of_TEDS/*/joint/joint_full_raw.csv
!/data/output/portion_of_TEDS/*/joint/pooled_sources.csv

# --- multical：一個 run 一個子資料夾 --------------------------
!/data/output/multical/
/data/output/multical/*
!/data/output/multical/*/
/data/output/multical/*/*
!/data/output/multical/*/*/
/data/output/multical/*/*/*
!/data/output/multical/*/*/weights_*.csv
!/data/output/multical/*/*/dist_*.csv
!/data/output/multical/*/*/diagnostics_*.txt
!/data/output/multical/*/*/target_*.csv
!/data/output/multical/*/*/coverage_*.csv
!/data/output/multical/*/*/lambda_path_*.csv
!/data/output/multical/*/*/balance_*.csv
!/data/output/multical/*/*/balance_*.png
!/data/output/multical/*/*/frontier_*.png
!/data/output/multical/*/*/dist_*_edu.png

# --- papp_bart：一種 trimming 一個子資料夾 --------------------
!/data/output/papp_bart/
/data/output/papp_bart/*
!/data/output/papp_bart/*/
/data/output/papp_bart/*/*
!/data/output/papp_bart/*/*/
/data/output/papp_bart/*/*/*
!/data/output/papp_bart/*/*/weights_*.csv
!/data/output/papp_bart/*/*/weights_*.png
!/data/output/papp_bart/*/*/dist_*.csv
!/data/output/papp_bart/*/*/diagnostics_*.txt
!/data/output/papp_bart/*/*/overlap_*.png
!/data/output/papp_bart/*/*/dist_*_edu.png

# --- raking：沒有子資料夾，只留代表性的圖 ---------------------
!/data/output/raking/*/dist_*_edu.png

# --- 個人層資料：一人一列，一律不上傳 -------------------------
# analysis_*.csv 含每個人的年齡、教育、三黨情感溫度計
/data/output/multical/*/*/analysis_*.csv
/data/output/papp_bart/*/*/analysis_*.csv

# --- 暫不上傳：比較程式還在調整 -------------------------------
/data/code/compare_raking_multical.R
# raking 的圖同樣只留代表性的那一張（舊規則會把整個資料夾的 png 放行）
/data/output/raking/*/collapse_*.png
/data/output/raking/*/dist_*_age.png
/data/output/raking/*/dist_*_arear.png
/data/output/raking/*/dist_*_ethnicity.png
/data/output/raking/*/dist_*_party_dpp.png
/data/output/raking/*/dist_*_party_kmt.png
/data/output/raking/*/dist_*_party_tpp.png
/data/output/raking/*/dist_*_sex.png
